---
// Häufige Fragen – immer vollständig sichtbar, kein Akkordeon.
import Pruefen from './Pruefen.astro';
import type { Faq } from '../data/faq';
interface Props { items: Faq[]; grid?: boolean }
const { items, grid = false } = Astro.props;
---
<div class:list={['faq', grid && 'faq--grid']}>
  {items.map(f => (
    <div class="item">
      <h3 class="q">{f.q}</h3>
      <p class="a">{f.a}</p>
      {f.pruefen && <Pruefen label={f.pruefen} />}
    </div>
  ))}
</div>
<style>
.faq--grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:0 var(--space-8)}
.item{padding:var(--space-6) 0;border-top:1px solid var(--border-default)}
.faq:not(.faq--grid) .item{padding:var(--space-5) 0}
.faq:not(.faq--grid) .item:last-child{border-bottom:1px solid var(--border-default)}
.q{margin:0 0 var(--space-3);font:var(--fw-semibold) 20px/1.3 var(--font-sans);color:var(--text-1)}
.a{margin:0;font:var(--fw-regular) var(--fs-body)/var(--lh-body) var(--font-sans);color:var(--text-2);text-wrap:pretty}
</style>
