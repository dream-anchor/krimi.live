---
// Design System · Button (variant/size wie KrimiLiveDesignSystem_fc12d8.Button), ohne Client-JS.
import Icon from './Icon.astro';
interface Props {
  variant?: 'primary' | 'highlight' | 'secondary' | 'ghost' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  href?: string; iconStart?: string; iconEnd?: string; disabled?: boolean; type?: 'button' | 'submit';
}
const { variant = 'primary', size = 'md', href, iconStart, iconEnd, disabled, type = 'button' } = Astro.props;
const iconSize = { sm: 16, md: 18, lg: 20 }[size];
const cls = ['btn', `btn--${variant}`, `btn--${size}`];
---
{href && !disabled
  ? <a class:list={cls} href={href}>{iconStart && <Icon name={iconStart} size={iconSize} />}<slot />{iconEnd && <Icon name={iconEnd} size={iconSize} />}</a>
  : <button class:list={cls} type={type} disabled={disabled}>{iconStart && <Icon name={iconStart} size={iconSize} />}<slot />{iconEnd && <Icon name={iconEnd} size={iconSize} />}</button>}
<style>
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:var(--radius-pill);border:1px solid transparent;font-family:var(--font-sans);font-weight:var(--fw-semibold);line-height:1;letter-spacing:.01em;text-decoration:none;white-space:nowrap;cursor:pointer;transition:background var(--dur-fast) var(--ease-out),transform var(--dur-fast) var(--ease-out)}
.btn--sm{height:var(--control-sm);padding:0 16px;font-size:14px}
.btn--md{height:var(--control-md);padding:0 22px;font-size:15px}
.btn--lg{height:var(--control-lg);padding:0 30px;font-size:17px}
.btn--primary{background:var(--accent);color:var(--on-accent)}
.btn--primary:hover{background:var(--accent-hover);color:var(--on-accent)}
.btn--primary:active{background:var(--accent-press)}
.btn--highlight{background:var(--highlight);color:var(--on-highlight)}
.btn--highlight:hover{background:var(--highlight-hover);color:var(--on-highlight)}
.btn--secondary{background:transparent;color:var(--text-1);border-color:var(--border-strong)}
.btn--secondary:hover{background:rgba(245,241,234,.08);color:var(--text-1)}
.btn--ghost{background:transparent;color:var(--text-1)}
.btn--ghost:hover{background:rgba(245,241,234,.06);color:var(--text-1)}
.btn--inverse{background:var(--surface-inverse);color:var(--text-inverse)}
.btn--inverse:hover{background:var(--noir-100);color:var(--text-inverse)}
.btn:active:not(:disabled){transform:scale(.97)}
.btn:disabled{background:var(--surface-3);color:var(--text-disabled);border-color:transparent;cursor:not-allowed}
.btn:focus-visible{outline:none;box-shadow:var(--focus-ring);border-radius:var(--radius-pill)}
</style>
