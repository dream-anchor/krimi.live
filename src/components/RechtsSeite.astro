---
interface Props { title: string; intro: string }
const { title, intro } = Astro.props;
---
<section class="recht">
  <div class="recht__in">
    <h1>{title}</h1>
    <p class="body intro">{intro}</p>
    <slot />
  </div>
</section>
<style>
.recht{padding:clamp(40px,7vw,80px) 0 var(--space-9)}
.recht__in{max-width:880px;margin:0 auto;padding:0 var(--gutter)}
h1{margin:0 0 var(--space-7);font-family:var(--font-display);font-weight:900;font-size:clamp(56px,9vw,112px);line-height:.88;text-transform:uppercase}
.intro{margin-bottom:var(--space-6)}
.recht__in :global(h2){margin:var(--space-8) 0 var(--space-4);font-family:var(--font-display);font-weight:800;font-size:clamp(26px,3vw,34px);line-height:var(--lh-heading);text-transform:uppercase}
.recht__in :global(h3){margin:var(--space-6) 0 var(--space-3);font:var(--fw-semibold) 18px/1.3 var(--font-sans)}
.recht__in :global(p),.recht__in :global(li){font:var(--fw-regular) var(--fs-body)/var(--lh-body) var(--font-sans);color:var(--text-2)}
.recht__in :global(p){margin:0 0 var(--space-4)}
</style>
