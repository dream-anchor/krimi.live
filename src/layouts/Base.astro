---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource/instrument-sans/400';
import '@fontsource/instrument-sans/500';
import '@fontsource/instrument-sans/600';
import '@fontsource/ibm-plex-mono/500';
import '../styles/global.css';
import Button from '../components/Button.astro';
import { BASE } from '../data/config';
import { aktiveFormate, laufendeFormate, formatPfad, ticketZiel } from '../lib/formate';
import type { PageMeta } from '../data/meta';
interface Props { meta: PageMeta; graph: any[]; ogImage?: { datei: string; alt: string }; noindex?: boolean }
const { meta, graph } = Astro.props;
const canonical = meta.canonical || BASE + meta.path;
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const path = Astro.url.pathname;
const aktiv = await aktiveFormate();
const laufend = await laufendeFormate();
const tickets = ticketZiel(laufend);
const formatLink = aktiv.length === 1 ? formatPfad(aktiv[0]) : '/#buehne';
const og = Astro.props.ogImage ?? aktiv[0]?.data.bilder.kopf;
const nav = [
  { href: formatLink, label: aktiv.length === 1 ? 'Format' : 'Formate' },
  { href: '/hintergruende/was-ist-ein-live-hoerspiel/', label: 'Hintergründe' },
  { href: '/ueber-uns/', label: 'Über uns' },
];
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta.title}</title>
  <meta name="description" content={meta.desc} />
  <link rel="canonical" href={canonical} />
  {Astro.props.noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#0B0A09" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="krimi.live" />
  <meta property="og:title" content={meta.title} />
  <meta property="og:description" content={meta.desc} />
  <meta property="og:url" content={canonical} />
  {og && <meta property="og:image" content={`${BASE}${og.datei}-1200.webp`} />}
  {og && <meta property="og:image:alt" content={og.alt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={ld} />
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt</a>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" aria-label="krimi.live – Startseite" class="mark">Krimi<span>.</span>live</a>
      <nav aria-label="Hauptnavigation" class="nav">
        {nav.map(n => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        <Button variant="primary" size="sm" href={tickets} iconEnd={laufend.length === 1 ? 'arrow-up-right' : undefined}>Tickets</Button>
      </nav>
    </div>
  </header>

  <main id="inhalt">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap foot">
      <div class="foot__brand">
        <a href="/" class="mark mark--l">Krimi<span>.</span>live</a>
        <p>Ein Magazin der Dream &amp; Anchor Handelsgesellschaft mbH, Produzentin von <a href="https://paterbrown.com/">„Pater Brown – Das Live-Hörspiel“</a>.<br />Künstlerische Leitung &amp; Creative Producerin: Stefanie Sick</p>
      </div>
      <nav aria-label="Fußnavigation" class="foot__nav">
        {aktiv.map(f => <a href={formatPfad(f)}>Format: {f.data.name}</a>)}
        <a href="/hintergruende/was-ist-ein-live-hoerspiel/">Was ist ein Live-Hörspiel?</a>
        {laufend.map(f => <a href={f.data.links.termine}>{`Termine${laufend.length > 1 ? ' ' + f.data.name : ''} bei ${new URL(f.data.links.termine).hostname}`}</a>)}
        <a href="/ueber-uns/">Über uns</a>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
      </nav>
    </div>
  </footer>
</body>
</html>
<style>
.site-header{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--bg-page) 82%,transparent);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--border-subtle)}
.bar{min-height:72px;display:flex;flex-wrap:wrap;align-items:center;gap:8px 24px}
.mark{font-family:var(--font-display);font-weight:900;font-size:30px;line-height:1;text-transform:uppercase;letter-spacing:-.01em;text-decoration:none;color:var(--text-1);padding:8px 0}
.mark span{color:var(--accent)}
.mark--l{font-size:44px;padding:0}
.nav{display:flex;flex-wrap:wrap;align-items:center;gap:4px 20px;margin-left:auto}
.nav a:not(.btn){font:var(--fw-medium) 15px/1 var(--font-sans);text-decoration:none;padding:12px 0}
.nav a[aria-current="page"]{text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:6px}
.site-footer{border-top:1px solid var(--border-default);background:var(--surface-1);padding:var(--space-8) 0 var(--space-7)}
.foot{display:flex;flex-wrap:wrap;gap:var(--space-6) var(--space-8)}
.foot__brand{flex:1 1 300px;min-width:0}
.foot__brand p{margin:var(--space-4) 0 0;font:var(--fw-regular) var(--fs-body-s)/1.6 var(--font-sans);color:var(--text-2)}
.foot__nav{flex:1 1 300px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 24px;align-content:start;font:var(--fw-medium) var(--fs-body-s)/1.4 var(--font-sans)}
</style>
