---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import Pruefen from '../../../components/Pruefen.astro';
import TerminListe from '../../../components/TerminListe.astro';
import { META } from '../../../data/meta';
import { TERMINE_URL, FORMAT_URL_EXTERN } from '../../../data/config';
import { getFeed } from '../../../lib/feed';
import { baseGraph, theaterEvents } from '../../../lib/schema';

const meta = META.format; // Canonical → paterbrown.com/live-hoerspiel/
const feed = await getFeed();
const graph = [...baseGraph(meta), ...theaterEvents(feed)];
const stimmen = [
  { name: 'Antoine Monot', rolle: 'Pater Brown · Co-Produzent' },
  { name: 'Wanja Mues', rolle: 'Erzähler und Flambeau' },
  { name: 'Marvelin · Hans Beatbox · Eyota', rolle: 'Beatbox, je nach Abend' },
];
---
<Base meta={meta} graph={graph}>
  <section class="kopf">
    <div class="wrap">
      <p class="overline overline--hl kopf__over">Format · Live-Hörspiel · auf Tour</p>
      <h1><span class="h1__a">Pater Brown</span><span class="sr-only"> – </span><span class="h1__b">Das Live-Hörspiel</span></h1>
      <div class="faelle">
        <div class="fall"><p class="overline overline--muted">Fall 1</p><p class="fall__t">„Das blaue Kreuz“</p></div>
        <div class="fall"><p class="overline overline--muted">Fall 2</p><p class="fall__t">„Die fallenden Brüder“</p></div>
      </div>
      <div class="faelle__fuss">
        <span class="overline overline--muted">Nach G. K. Chesterton · zwei Fälle an einem Abend</span>
        <Pruefen label="Programm" block={false} />
      </div>
    </div>
  </section>

  <section aria-labelledby="f-worum" class="worum">
    <div class="wrap split">
      <h2 id="f-worum" class="h2 h2--s split__side">Worum es geht</h2>
      <p class="lead split__main">Pater Brown, der unscheinbare Pfarrer aus den Kriminalgeschichten von G. K. Chesterton, löst seine Fälle durch Menschenkenntnis statt durch Spurensicherung. Im Live-Hörspiel erleben Zuschauer zwei dieser Fälle an einem Abend, nur mit Stimme, Geräusch und Fantasie.</p>
    </div>
  </section>

  <section aria-labelledby="f-stimmen" class="sec sec--m sec--alt">
    <div class="wrap split">
      <h2 id="f-stimmen" class="h2 h2--s split__side">Die Stimmen des Abends</h2>
      <div class="split__main">
        <dl class="stimmen">
          {stimmen.map(s => <div><dt>{s.name}</dt><dd>{s.rolle}</dd></div>)}
        </dl>
        <p class="body tv">Beide Schauspieler kennt das Fernsehpublikum aus „Ein Fall für zwei“ (ZDF).</p>
        <Pruefen label="TV-Bezug" />
        <p class="credit">Künstlerische Leitung &amp; Creative Producerin: Stefanie Sick</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="f-ablauf" class="sec sec--m">
    <div class="wrap split">
      <h2 id="f-ablauf" class="h2 h2--s split__side">Ablauf und Dauer</h2>
      <div class="split__main">
        <p class="lead">Etwa zwei Stunden inklusive 15 Minuten Pause, ohne Kostümwechsel und ohne Bühnenbild. Empfohlen ab etwa 12 Jahren.</p>
        <Pruefen label="Bühnenbild" />
      </div>
    </div>
  </section>

  <section aria-labelledby="f-termine" class="sec sec--m">
    <div class="wrap split">
      <h2 id="f-termine" class="h2 h2--s split__side">Termine und Tickets</h2>
      <div class="split__main">
        <TerminListe feed={feed} />
        <div class="btns mt6">
          <Button variant="primary" size="lg" href={TERMINE_URL} iconEnd="arrow-up-right">Alle Termine und Tickets</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--m">
    <div class="wrap schluss">
      <a href={FORMAT_URL_EXTERN} class="schluss__a">Mehr zur Show, zum Ensemble und zur Presse bei paterbrown.com</a>
      <a href="/hintergruende/was-ist-ein-live-hoerspiel/" class="link-strong">Hintergrund: Was ist ein Live-Hörspiel?</a>
    </div>
  </section>
</Base>
<style>
.kopf{padding:clamp(40px,7vw,88px) 0 0}
.kopf__over{margin-bottom:var(--space-5)}
h1{margin:0;font-family:var(--font-display);font-weight:900;font-size:clamp(68px,14vw,184px);line-height:.84;letter-spacing:-.01em;text-transform:uppercase}
.h1__a{display:block}
.h1__b{display:block;margin-top:.12em;font-weight:700;font-size:.34em;line-height:1;color:var(--text-2)}
.faelle{margin-top:var(--space-8);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));border-top:1px solid var(--border-default)}
.fall{padding:var(--space-6) var(--space-6) var(--space-6) 0;border-bottom:1px solid var(--border-default)}
.fall .overline{margin-bottom:var(--space-3)}
.fall__t{margin:0;font-family:var(--font-display);font-weight:800;font-size:clamp(36px,5vw,60px);line-height:1.02;text-transform:uppercase}
.faelle__fuss{display:flex;flex-wrap:wrap;align-items:center;gap:12px;padding:var(--space-4) 0}
.worum{padding:var(--space-9) 0 var(--space-8)}
.sec--m{padding:var(--space-8) 0}
.stimmen{margin:0;border-top:1px solid var(--border-default)}
.stimmen div{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 24px;padding:var(--space-5) 0;border-bottom:1px solid var(--border-default)}
.stimmen dt{flex:1 1 260px;font-family:var(--font-display);font-weight:800;font-size:34px;line-height:1;text-transform:uppercase}
.stimmen dd{flex:1 1 220px;margin:0;font:var(--fw-medium) 13px/1.4 var(--font-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--text-2)}
.tv{margin-top:var(--space-5)}
.credit{margin:var(--space-5) 0 0;font:var(--fw-semibold) var(--fs-body)/var(--lh-body) var(--font-sans);color:var(--text-1)}
.mt6{margin-top:var(--space-6)}
.schluss{display:flex;flex-wrap:wrap;gap:var(--space-4) var(--space-7);align-items:center}
.schluss__a{font-family:var(--font-display);font-weight:800;font-size:clamp(26px,3.4vw,40px);line-height:1.05;text-transform:uppercase;text-decoration:underline;text-decoration-thickness:2px}
</style>
